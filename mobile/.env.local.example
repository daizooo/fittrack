# Supabase（Web版と同じ統合プロジェクト「Persol」の値。データは fittrack スキーマ）
# Find these in: Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------------
# Setup:
# 1. このファイルを .env.local にコピーして値を入れる
# 2. Google OAuthのリダイレクト先として、Supabase Dashboard >
#    Authentication > URL Configuration > Redirect URLs に
#    `fittrack://**` を追加する（このリダイレクトが無いと
#    ログイン後にアプリへ戻ってこられない）
# --------------------------------------------------
