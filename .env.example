# Supabase（統合プロジェクト「Persol」。データは fittrack スキーマ）
# Find these in: Supabase Dashboard > Project Settings > API Keys / Data API
VITE_SUPABASE_URL=https://jmysgeulujggdmdthqkn.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------------
# Setup instructions:
# 1. Copy this file to .env.local and fill in your values
# 2. Dashboard > Project Settings > Data API > Exposed schemas に `fittrack` を追加
# 3. supabase/migrations/001_fittrack_schema.sql を SQL Editor で実行
# 4. Enable Google OAuth: Supabase Dashboard > Auth > Providers > Google
# 5. For PWA: generate icon-192.png and icon-512.png from public/icon.svg
#    using a tool like https://realfavicongenerator.net
#    and place them in the public/ directory
# --------------------------------------------------
