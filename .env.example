# Supabase
# Find these in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------------
# Setup instructions:
# 1. Copy this file to .env and fill in your values
# 2. Run migrations: paste supabase/migrations/001_initial.sql
#    into Supabase Dashboard > SQL Editor
# 3. Enable Google OAuth: Supabase Dashboard > Auth > Providers > Google
# 4. For PWA: generate icon-192.png and icon-512.png from public/icon.svg
#    using a tool like https://realfavicongenerator.net
#    and place them in the public/ directory
# --------------------------------------------------
